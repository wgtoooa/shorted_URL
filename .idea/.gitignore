# Dependency directories (if you use vendoring)
vendor/

# OS-generated files
.DS_Store
Thumbs.db

# Sensitive files
server.key
ssl.conf
.env
*.pem

# Logs
*.log

# Coverage/output files
coverage.*
*.coverprofile
*.cov
